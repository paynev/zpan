# Local development secrets for `wrangler dev` / `vite dev`.
# Copy this file to `.dev.vars` (gitignored) and fill in real values.

# Required: the single administrator account, seeded on first boot only.
# ZPAN_USERNAME is the login identity: a plain username (e.g. "admin") or a
# full email address. Plain usernames are mapped internally to <name>@zpan.local
# and may contain letters, digits, dots, hyphens and underscores only. Values
# are lower-cased before seeding/sign-in. Set both before the first start;
# self-service sign-up is disabled afterwards.
ZPAN_USERNAME=admin
ZPAN_PASSWORD=

# BETTER_AUTH_SECRET is derived automatically from the two values above with
# HMAC-SHA256, producing a stable 64-character hex signing key. Do not set it
# unless you need to override the derived value (e.g. migrating an existing
# deployment). Changing either credential rotates the key and invalidates all
# existing sessions.
# BETTER_AUTH_SECRET=

# Local ZPan URL.
BETTER_AUTH_URL=http://localhost:5185
TRUSTED_ORIGINS=http://localhost:5185
# Optional comma-separated hosts accepted by the Vite development server.
# Cloudflare Quick Tunnel (*.trycloudflare.com) is already allowed in development.
ZPAN_DEV_ALLOWED_HOSTS=

# Explicit Node runtime only; Workers always use simulated D1.
# DATABASE_URL=./.local/node/zpan.db
